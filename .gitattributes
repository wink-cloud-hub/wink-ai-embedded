# Git attributes configuration
#
# Objectives:
# 1. Store text files with LF line endings consistently to avoid CRLF/LF mixing.
# 2. Enforce UTF-8 encoding for Markdown and text files to eliminate encoding issues on Windows.
# 3. Keep binary files untransformed.

# Default: auto-detect text, store with LF in repository
* text=auto eol=lf

# ── Documentation: Enforce UTF-8 ──────────────────────────────────
*.md        text eol=lf working-tree-encoding=UTF-8
*.markdown  text eol=lf working-tree-encoding=UTF-8
*.txt       text eol=lf working-tree-encoding=UTF-8
*.adoc      text eol=lf working-tree-encoding=UTF-8

# ── Source Code & Scripts: UTF-8, LF ──────────────────────────────
*.c    text eol=lf working-tree-encoding=UTF-8
*.h    text eol=lf working-tree-encoding=UTF-8
*.cpp  text eol=lf working-tree-encoding=UTF-8
*.hpp  text eol=lf working-tree-encoding=UTF-8
*.cc   text eol=lf working-tree-encoding=UTF-8
*.ts   text eol=lf working-tree-encoding=UTF-8
*.js   text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
*.py   text eol=lf working-tree-encoding=UTF-8
*.cmake text eol=lf working-tree-encoding=UTF-8
CMakeLists.txt text eol=lf working-tree-encoding=UTF-8

# ── Windows Scripts: Retain CRLF ──────────────────────────────────
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf working-tree-encoding=UTF-8

# ── Binary Files ──────────────────────────────────────────────────
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.pdf   binary
*.wasm  binary
*.zip   binary
*.gz    binary
*.bin   binary
*.o     binary
*.a     binary
*.lib   binary
*.obj   binary
*.exe   binary
*.dll   binary
*.so    binary
