{
  "app_name": "health_pot",
  "display_name": "CMS8S78xx Commercial Health Pot (4COM-8SEG + Buzzer + 12-bit NTC)",
  "board": "cms8s78xx_devboard",
  "mcu": "cms8s78xx",
  "tick_ms": 10,
  "devices": {
    "display": {
      "type": "seg_display",
      "variant": "direct_gpio_4d",
      "label": "水温/倒计时",
      "com0_pin": "$board.headers.P30",
      "com1_pin": "$board.headers.P31",
      "com2_pin": "$board.headers.P32",
      "com3_pin": "$board.headers.P33",
      "a_pin": "$board.headers.P10",
      "b_pin": "$board.headers.P11",
      "c_pin": "$board.headers.P12",
      "d_pin": "$board.headers.P13",
      "e_pin": "$board.headers.P14",
      "f_pin": "$board.headers.P15",
      "g_pin": "$board.headers.P16",
      "dp_pin": "$board.headers.P17"
    },
    "buzzer": {
      "type": "buzzer",
      "variant": "passive_pwm",
      "pins": {
        "1": "$board.headers.P03"
      },
      "label": "蜂鸣器"
    },
    "heater_relay": {
      "type": "led",
      "gpio_pin": "$board.headers.P20",
      "active_high": true,
      "color": "orange",
      "label": "发热盘",
      "pullDownResistor": 4700
    },
    "led_heat": {
      "type": "led",
      "gpio_pin": "$board.headers.P01",
      "active_high": false,
      "color": "red",
      "label": "加热"
    },
    "led_warm": {
      "type": "led",
      "gpio_pin": "$board.headers.P02",
      "active_high": false,
      "color": "green",
      "label": "保温"
    },
    "led_fault": {
      "type": "led",
      "gpio_pin": "$board.headers.P06",
      "active_high": false,
      "color": "yellow",
      "label": "故障"
    },
    "btn_onoff": {
      "type": "button",
      "gpio_pin": "$board.headers.P04",
      "active_low": true,
      "color": "red",
      "label": "电源"
    },
    "btn_func": {
      "type": "button",
      "gpio_pin": "$board.headers.P05",
      "active_low": true,
      "color": "blue",
      "label": "功能/模式"
    },
    "temp_sensor": {
      "type": "ntc",
      "pins": {
        "OUT": "$board.headers.P00"
      },
      "label": "水温探头",
      "temperature": 25,
      "r25": 10000,
      "bValue": 3950,
      "pullUpResistor": 160000,
      "vref": 3.0
    }
  },
  "plant_profiles": [
    {
      "id": "pot_default",
      "sampleIntervalUs": "10ms",
      "model": {
        "kind": "first_order_thermal",
        "thermalCapacity": 1256,
        "thermalResistance": 1.5,
        "ambientTempC": 25,
        "ratedPowerW": 1000
      },
      "inputPorts": {
        "power": {
          "from": "device:heater_relay"
        }
      },
      "outputPorts": {
        "temperature_c": {
          "to": "plugin:temp_sensor/temperature"
        }
      },
      "probes": [
        {
          "port": "temperature_c",
          "as": "buffer:pot/water_temp_c"
        }
      ]
    }
  ]
}
