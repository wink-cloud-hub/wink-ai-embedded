{
  "appName": "health_pot",
  "board": "cms8s78xx_devboard",
  "devices": {
    "display": {
      "id": "display",
      "type": "seg_display",
      "label": "水温/倒计时",
      "pinMapping": {
        "DIG1": 24,
        "DIG2": 25,
        "DIG3": 26,
        "DIG4": 27,
        "A": 8,
        "B": 9,
        "C": 10,
        "D": 11,
        "E": 12,
        "F": 13,
        "G": 14,
        "DP": 15
      },
      "properties": {
        "variant": "direct_gpio_4d",
        "label": "水温/倒计时"
      }
    },
    "buzzer": {
      "id": "buzzer",
      "type": "buzzer",
      "label": "蜂鸣器",
      "pinMapping": {
        "1": 3
      },
      "properties": {
        "variant": "passive_pwm",
        "label": "蜂鸣器"
      }
    },
    "heater_relay": {
      "id": "heater_relay",
      "type": "led",
      "label": "发热盘",
      "pinMapping": {
        "A": 16
      },
      "properties": {
        "activeHigh": true,
        "color": "orange",
        "label": "发热盘",
        "pullDownResistor": 4700
      }
    },
    "led_heat": {
      "id": "led_heat",
      "type": "led",
      "label": "加热",
      "pinMapping": {
        "A": 1
      },
      "properties": {
        "activeHigh": false,
        "color": "red",
        "label": "加热"
      }
    },
    "led_warm": {
      "id": "led_warm",
      "type": "led",
      "label": "保温",
      "pinMapping": {
        "A": 2
      },
      "properties": {
        "activeHigh": false,
        "color": "green",
        "label": "保温"
      }
    },
    "led_fault": {
      "id": "led_fault",
      "type": "led",
      "label": "故障",
      "pinMapping": {
        "A": 6
      },
      "properties": {
        "activeHigh": false,
        "color": "yellow",
        "label": "故障"
      }
    },
    "btn_onoff": {
      "id": "btn_onoff",
      "type": "button",
      "label": "电源",
      "pinMapping": {
        "1.l": 4
      },
      "properties": {
        "activeLow": true,
        "color": "red",
        "label": "电源"
      }
    },
    "btn_func": {
      "id": "btn_func",
      "type": "button",
      "label": "功能/模式",
      "pinMapping": {
        "1.l": 5
      },
      "properties": {
        "activeLow": true,
        "color": "blue",
        "label": "功能/模式"
      }
    },
    "temp_sensor": {
      "id": "temp_sensor",
      "type": "ntc",
      "label": "水温探头",
      "pinMapping": {
        "OUT": 0
      },
      "properties": {
        "label": "水温探头",
        "temperature": 25,
        "r25": 10000,
        "bValue": 3950,
        "pullUpResistor": 160000,
        "vref": 3.0
      }
    }
  },
  "family": "mcs51",
  "core": "8051",
  "mcu": "cms8s78xx",
  "vendor": "cmsemicon",
  "plantProfiles": [
    {
      "id": "pot_default",
      "sampleIntervalUs": "10000",
      "model": {
        "kind": "first_order_thermal",
        "thermalCapacity": 1256,
        "thermalResistance": 1.5,
        "ambientTempC": 25,
        "ratedPowerW": 1000
      },
      "inputPorts": {
        "power": {
          "from": "gpio:16",
          "invert": false
        }
      },
      "outputPorts": {
        "temperature_c": {
          "to": "plugin:temp_sensor/temperature"
        }
      },
      "probes": [
        {
          "port": "temperature_c",
          "as": "buffer:pot/water_temp_c"
        }
      ]
    }
  ]
}
