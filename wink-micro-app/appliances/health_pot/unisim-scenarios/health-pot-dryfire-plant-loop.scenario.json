{
  "header": {
    "version": "1.0.0",
    "name": "mcs51_health_pot safety: plant-excited dry kettle runs beyond NTC scale in ~1 s, E-04 latches after the 10 s qualification",
    "templateId": "mcs51_health_pot",
    "accuracyMode": "behavioral",
    "timeoutUs": "18000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "plantConditions": {
    "pot_default": {
      "parameters": {
        "thermalCapacity": 10,
        "thermalResistance": 300
      },
      "description": "等效空壶绝热干烧工况 (C=10 J/K, R=300 K/W)"
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "300ms",
      "target": "plugin:temp_sensor/voltageRatio",
      "matcher": { "$between": [0.058, 0.0596] },
      "description": "NTC transducer anchor (P2): 25.0 C ambient -> raw 241 before heating"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "400ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true },
      "description": "Power on (300 ms atomic pulse, ADR-0068)"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "700ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "2000ms",
      "target": "plugin:temp_sensor/temperature",
      "matcher": { "$between": [100, 130] },
      "description": "Fast dry-kettle rise: plate crosses the ~105 C beyond-scale boundary roughly 1 s after the relay closes (>= +75 C while powered)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "2000ms",
      "target": "plugin:heater_relay/on",
      "matcher": false,
      "description": "Extreme-cut protection: beyond-scale band forces the contact open while E-04 qualifies"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["5800ms", "6200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=0,F=0",
      "minPackets": 1,
      "description": "Qualification window: HEAT state, heater off, no fault latched yet"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "10000ms",
      "target": "plugin:temp_sensor/temperature",
      "matcher": { "$between": [100, 130] },
      "description": "Sustained beyond-scale plateau: the plate stays above the qualification threshold for the full 10 s window"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "12500ms",
      "target": "plugin:display/text",
      "matcher": "E-04",
      "description": "10 continuous seconds beyond scale latch over-temp E-04"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["12800ms", "14200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=3,H=0,F=4",
      "minPackets": 1,
      "description": "Telemetry: FAULT over-temp (S=3,H=0,F=4), manual reset required"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "15000ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "15300ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["15800ms", "16200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=0,H=0,F=0",
      "minPackets": 1,
      "description": "Manual ON/OFF clears the E-04 latch back to standby"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "16000ms",
      "target": "plugin:heater_relay/on",
      "matcher": false,
      "description": "Heater remains off after manual reset"
    }
  ]
}
