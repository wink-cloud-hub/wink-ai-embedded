{
  "app_name": "adc_hardware_trigger",
  "display_name": "CMS8S78xx V2.0.2 - ADC Hardware Trigger (P0.5 ADET falling -> AN0 ADC -> P3.2 toggle)",
  "board": "cms8s78xx_devboard",
  "category": "vendor_example",
  "mcu": "cms8s78xx",
  "tick_ms": 1,
  "upstream": {
    "vendor": "Cmsemicon",
    "version": "V2.0.2",
    "source_dir": "docs/vendors/Cmsemicon/CMS8S78xx_DemoCode_V2.0.2/CMS8S78xx_Example/Example/ADC/HardwareTrigger/code"
  },
  "devices": {
    "btn": {
      "type": "button",
      "gpio_pin": "$board.headers.P05",
      "active_low": true
    },
    "led": {
      "type": "led",
      "gpio_pin": "$board.headers.P32",
      "active_high": true
    }
  }
}
