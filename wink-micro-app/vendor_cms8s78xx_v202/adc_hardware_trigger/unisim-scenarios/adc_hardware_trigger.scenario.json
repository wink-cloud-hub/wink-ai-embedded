{
  "header": {
    "version": "2.0",
    "name": "mcs51 CMS8S78xx ADC HardwareTrigger (P0.5 ADET falling -> AN0 ADC -> P3.2 toggle) headless proof",
    "templateId": "vendor_cms8s78xx_v202_adc_hardware_trigger",
    "accuracyMode": "behavioral",
    "timeoutUs": "2000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "20ms",
      "adcChannel": 0,
      "valueNorm": 0.5,
      "description": "Drive AN0 (physical pin 0, v2 rail key) to mid-scale voltage"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "gpio:5",
      "matcher": 1,
      "description": "[上电初始] P0.5 (Pin 5 / ADET 按键) 内部上拉输入，空闲为高电平 1"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "gpio:26",
      "matcher": 0,
      "description": "[上电初始] P3.2 (Pin 26 / LED) 初始置低，LED 熄灭"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "100ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "150ms",
      "target": "gpio:5",
      "matcher": 0,
      "description": "[按下按键] P0.5 瞬间跳变为低电平 0 (产生下降沿)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "200ms",
      "target": "gpio:26",
      "matcher": 1,
      "description": "[首次触发] 下降沿经 PS_ADET 复用触发 ADC 硬件采样，EOC 中断 19 执行 P32=~P32，P3.2 翻转为 1 (LED 点亮)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "500ms",
      "target": "gpio:5",
      "matcher": 0,
      "description": "[长按保持 400ms] P0.5 持续锁死在低电平 0"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1000ms",
      "target": "gpio:26",
      "matcher": 1,
      "description": "[状态稳定] 边沿触发下长按不重复触发，P3.2 稳定保持为 1"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "1100ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1200ms",
      "target": "gpio:5",
      "matcher": 1,
      "description": "[松开按键] P0.5 恢复高电平 1 (产生上升沿)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1200ms",
      "target": "gpio:26",
      "matcher": 1,
      "description": "[边沿单向性] 配置为下降沿触发 (ADC_TG_FALLING)，松开上升沿不触发转换，P3.2 依然保持高电平 1"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "1500ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1600ms",
      "target": "gpio:26",
      "matcher": 0,
      "description": "[再次按下] 第二次下降沿触发第二次 ADC 转换，中断再次翻转 P3.2 回 0 (LED 熄灭)"
    }
  ]
}
