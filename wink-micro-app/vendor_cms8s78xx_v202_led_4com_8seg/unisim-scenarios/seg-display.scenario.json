{
  "header": {
    "version": "2.0",
    "name": "mcs51 CMS8S78xx 4COM-8SEG display headless proof",
    "templateId": "vendor_cms8s78xx_v202_led_4com_8seg",
    "accuracyMode": "behavioral",
    "timeoutUs": "2000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "gpio:0",
      "matcher": 0,
      "description": "P0.0 heartbeat pin initialized to LOW"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "100ms",
      "target": "gpio:24",
      "matcher": 0,
      "description": "COM0 (P3.0) driven LOW during scanning"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "200ms",
      "target": "plugin:display/activeDigits",
      "matcher": 4,
      "description": "SegDisplayPlugin detects all 4 digits actively multiplexed"
    }
  ]
}
