{
  "app_name": "devkitc_smoke",
  "board": "esp32_devkitc",
  "devices": {
    "board_led": {
      "use_onboard": "status_led"
    },
    "boot_button": {
      "use_onboard": "boot_button",
      "long_press_ms": 3000,
      "isr_counter": true,
      "auto_poll_ms": 10
    },
    "smoke_sonar": {
      "type": "ultrasonic",
      "trig_pin": "$board.headers.D18",
      "echo_pin": "$board.headers.D19",
      "use_rmt": true
    }
  }
}
