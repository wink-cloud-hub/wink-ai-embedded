{
  "header": {
    "version": "2.0",
    "name": "mcs51 /INT0 interrupt button->led headless proof (Stage 2 T3)",
    "templateId": "mcs51_button_led_int",
    "accuracyMode": "behavioral",
    "timeoutUs": "2500000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "100ms",
      "target": "plugin:led/on",
      "matcher": false,
      "description": "LED off before press (ISR has not fired yet)"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "200ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "700ms",
      "target": "plugin:led/on",
      "matcher": true,
      "description": "First press: falling edge vectors INT0 ISR -> LED toggles on"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "700ms",
      "target": "gpio:8",
      "matcher": 0,
      "description": "MCU drives P1.0 (linear pin 8) low after the edge ISR"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "800ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1200ms",
      "target": "plugin:led/on",
      "matcher": true,
      "description": "Release is a RISING edge: edge-mode INT0 does NOT re-fire, LED stays on"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1200ms",
      "target": "gpio:8",
      "matcher": 0,
      "description": "P1.0 still low — ISR toggles only on falling edges"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "1300ms",
      "targetPluginId": "btn",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1900ms",
      "target": "plugin:led/on",
      "matcher": false,
      "description": "Second press: next falling edge vectors INT0 ISR again -> LED toggles off"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1900ms",
      "target": "gpio:8",
      "matcher": 1,
      "description": "MCU drives P1.0 high after the second edge ISR"
    }
  ]
}
