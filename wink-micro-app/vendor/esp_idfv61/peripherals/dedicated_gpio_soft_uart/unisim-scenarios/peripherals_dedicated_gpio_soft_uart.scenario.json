{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 dedicated_gpio_soft_uart headless deterministic proof",
    "templateId": "esp_idfv61_peripherals_dedicated_gpio_soft_uart",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "UART transfers succeeded, received bytes:",
      "description": "断言软件串口收发传输成功日志输出"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "0x48 0x65 0x6c 0x6c 0x6f",
      "description": "断言软件串口接收到匹配的十六进制字节序列"
    }
  ]
}
