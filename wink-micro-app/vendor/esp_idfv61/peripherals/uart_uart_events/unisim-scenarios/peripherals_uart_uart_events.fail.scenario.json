{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 peripherals_uart_uart_events parity error & FIFO overflow defense proof",
    "templateId": "esp_idfv61_uart_uart_events_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "INPUT_BUS",
      "timeUs": "100ms",
      "mode": "stream",
      "busType": "uart",
      "busId": 0,
      "payload": {
        "encoding": "utf8",
        "text": "HELLO_ESP32_WINK"
      },
      "description": "[数据事件注入] 向 UART0 注入常规测试数据触发 UART_DATA 事件"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "100ms",
        "1200ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "[DATA EVT]:",
      "description": "[事件队列响应] 验证事件任务成功响应普通数据到达并触发回显"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "100ms",
        "1200ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "[UART DATA]: 16",
      "description": "[数据长度校验] 验证事件结构体中携带的接收数据长度准确"
    },
    {
      "type": "INPUT_BUS",
      "timeUs": "1500ms",
      "mode": "stream",
      "busType": "uart",
      "busId": 0,
      "payload": {
        "encoding": "utf8",
        "text": "+++"
      },
      "description": "[模式检测字符注入] 注入模式匹配字符 +++ 触发模式检测事件"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "1500ms",
        "2800ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "[UART PATTERN DETECTED] pos: 0",
      "description": "[模式中断捕获] 断言驱动模式中断准确捕获偏移位置"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "1500ms",
        "2800ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "read pat : +++",
      "description": "[模式数据弹出] 验证准确弹出匹配的模式字符 +++"
    }
  ]
}
