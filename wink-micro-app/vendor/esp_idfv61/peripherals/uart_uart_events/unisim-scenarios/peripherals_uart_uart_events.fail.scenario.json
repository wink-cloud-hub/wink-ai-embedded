{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 peripherals_uart_uart_events framing error handling and recovery proof",
    "templateId": "esp_idfv61_uart_uart_events_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "INPUT_BUS",
      "timeUs": "100ms",
      "mode": "stream",
      "busType": "uart",
      "busId": 0,
      "payload": {
        "encoding": "utf8",
        "text": "PRE_FRAME_WINK"
      },
      "description": "[前置正常序列] 注入前置正常通信载荷"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "100ms",
        "700ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "[DATA EVT]:",
      "description": "[前置正常响应] 断言事件驱动任务正常处理前置载荷并回显"
    },
    {
      "type": "INJECT_PLATFORM_FAULT",
      "timeUs": "800ms",
      "domain": "uart",
      "fault": {
        "action": "framing_error",
        "flags": 1,
        "port": 0
      },
      "description": "[故障注入] 注入硬件 UART 帧错误事件 (UART_FRAME_ERR)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "800ms",
        "1400ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "uart frame error",
      "description": "[故障处理观测] 断言原厂事件任务正确捕获帧错误并输出错误处理日志"
    },
    {
      "type": "INPUT_BUS",
      "timeUs": "1500ms",
      "mode": "stream",
      "busType": "uart",
      "busId": 0,
      "payload": {
        "encoding": "utf8",
        "text": "POST_FRAME_WINK"
      },
      "description": "[同实例恢复] 故障后注入新业务载荷验证链路完全恢复"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "1500ms",
        "2800ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "[DATA EVT]:",
      "description": "[恢复断言] 验证同实例在异常处理后无需重启即可持续正常接收与回显"
    }
  ]
}
