{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 spi_master_hd_eeprom transfer fail & bus defense proof",
    "templateId": "esp_idfv61_spi_master_hd_eeprom_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing bus SPI2...",
      "description": "[总线初始化] 验证 SPI2 半双工总线成功就绪"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing device...",
      "description": "[器件初始化] 验证 AT93C46D 从机设备加载就绪"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Write: Hello World!",
      "description": "[半双工写入] 验证半双工 SPI 写入目标字符串"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read: Hello World!",
      "description": "[半双工回读] 验证半双工 SPI 回读字符串强一致性匹配"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Example finished.",
      "description": "[流程闭环] 验证 SPI EEPROM 读写流程完全执行完毕"
    }
  ]
}
