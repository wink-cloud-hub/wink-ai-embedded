{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 spi_master_hd_eeprom headless deterministic proof",
    "templateId": "esp_idfv61_spi_master_hd_eeprom",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing bus SPI2...",
      "description": "断言 SPI2 主线总线初始化成功"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing device...",
      "description": "断言 AT93C46D 外挂 EEPROM 挂载成功"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Write: Hello World!",
      "description": "断言半双工 SPI 写入测试字符串 'Hello World!'"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read: Hello World!",
      "description": "断言半双工 SPI 读回测试字符串并完全匹配 'Hello World!'"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Example finished.",
      "description": "断言 SPI EEPROM 读写测试全流程圆满完成"
    }
  ]
}
