{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 i2c_basic headless deterministic proof",
    "templateId": "esp_idfv61_i2c_basic",
    "accuracyMode": "behavioral",
    "timeoutUs": "2000000",
    "failurePolicy": "fail-fast",
