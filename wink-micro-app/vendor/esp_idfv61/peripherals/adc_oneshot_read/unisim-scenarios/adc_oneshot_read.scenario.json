      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 32,
      "valueNorm": 0.75,
      "description": "向 ADC1 Channel 4 (GPIO 32) 输入 75% 模拟电压"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 33,
      "valueNorm": 0.25,
      "description": "向 ADC1 Channel 5 (GPIO 33) 输入 25% 模拟电压"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 4,
      "valueNorm": 0.5,
      "description": "向 ADC2 Channel 0 (GPIO 4) 输入 50% 模拟电压"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
