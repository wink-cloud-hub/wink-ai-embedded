      "description": "断言 ADC1 Channel 5 固件校准采样电压 775 mV (25% 满量程)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1800ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "ADC2 Channel[0] Cali Voltage: 1550 mV",
      "description": "断言 ADC2 Channel 0 固件校准采样电压 1550 mV (50% 满量程)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["2800ms", "3500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "ADC1 Channel[4] Cali Voltage: 2325 mV",
      "description": "断言 ADC1 Channel 4 固件校准采样电压 2325 mV (75% 满量程)"
