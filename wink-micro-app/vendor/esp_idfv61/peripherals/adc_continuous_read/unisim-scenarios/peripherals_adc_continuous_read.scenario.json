{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 adc_continuous_read headless deterministic proof",
    "templateId": "esp_idfv61_adc_continuous_read",
    "accuracyMode": "behavioral",
    "timeoutUs": "30ms",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 34,
      "valueNorm": 0.484,
      "description": "向 ADC1 Channel 6 (GPIO 34) 输入 1500mV 归一化模拟电压 (1500/3100 ≈ 0.484)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 35,
      "valueNorm": 0.806,
      "description": "向 ADC1 Channel 7 (GPIO 35) 输入 2500mV 归一化模拟电压 (2500/3100 ≈ 0.806)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "10ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统核心供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "30ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "adc_pattern[0].channel is :6",
      "description": "断言 ADC 连续采样模式成功配置通道 6 (GPIO 34)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "30ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "adc_pattern[1].channel is :7",
      "description": "断言 ADC 连续采样模式成功配置通道 7 (GPIO 35)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "30ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "ADC1, Channel: 6, Value: 1982",
      "description": "断言固件 DMA 采集解析通道 6 工程值 (1500mV 对应 1982)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "30ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "ADC1, Channel: 7, Value: 3301",
      "description": "断言固件 DMA 采集解析通道 7 工程值 (2500mV 对应 3301)"
    }
  ]
}
