{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 dac_oneshot disabled channel write defense proof",
    "templateId": "esp_idfv61_dac_dac_oneshot_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3500ms",
