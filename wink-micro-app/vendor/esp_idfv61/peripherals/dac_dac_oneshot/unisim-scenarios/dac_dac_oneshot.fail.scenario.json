      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 25,
      "valueNorm": 0.4,
      "description": "向 DAC/ADC Channel 0 (GPIO 25) 注入 40% 模拟电学基准"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "0ms",
      "adcChannel": 26,
      "valueNorm": 0.7,
      "description": "向 DAC/ADC Channel 1 (GPIO 26) 注入 70% 模拟电学基准"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "500ms",
      "target": "adc:25",
      "matcher": {
        "$near": {
          "target": 0.4,
          "tolerance": 0.05
        }
      },
      "description": "[单次DAC通道0断言] 验证 DAC Channel 0 模拟输出稳定维持 0.4"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "adc:26",
      "matcher": {
        "$near": {
          "target": 0.7,
          "tolerance": 0.05
        }
      },
      "description": "[单次DAC通道1断言] 验证 DAC Channel 1 模拟输出稳定维持 0.7"
