{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 gptimer_alarm headless deterministic proof",
    "templateId": "esp_idfv61_gptimer_alarm",
    "accuracyMode": "behavioral",
    "timeoutUs": "12000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "100ms",
      "target": "timer:0/frequencyhz",
      "matcher": 1000000,
      "description": "断言通用硬件定时器基础时钟频率配置为 1MHz (1µs 分辨率)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "500ms",
      "target": "timer:0/counter",
      "matcher": { "$between": [400000, 600000] },
      "description": "断言硬件定时器运行推进至 500ms 窗口"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1000ms",
      "target": "timer:0/counter",
      "matcher": { "$between": [900000, 1100000] },
      "description": "断言硬件定时器运行推进至 1000ms 告警触发窗口"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "2000ms",
      "target": "timer:0/counter",
      "matcher": { "$between": [1900000, 2100000] },
      "description": "断言自动重载阶段硬件定时器持续推进至 2000ms 窗口"
    }
  ]
}
