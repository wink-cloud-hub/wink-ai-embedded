{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 peripherals_ledc_ledc_fade zero-duty cut-off proof",
    "templateId": "esp_idfv61_ledc_ledc_fade_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "800ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "1. LEDC fade up to duty = 4000",
      "description": "断言多通道平滑渐变升占空比启动"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "500ms",
      "target": "pwm:0",
      "matcher": 48.83,
      "description": "断言阶段 3 中 LEDC 通道 0 输出 48.83% PWM 占空比"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "1400ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "4. LEDC set duty = 0 without fade",
      "description": "断言占空比直接清零配置日志"
    }
  ]
}
