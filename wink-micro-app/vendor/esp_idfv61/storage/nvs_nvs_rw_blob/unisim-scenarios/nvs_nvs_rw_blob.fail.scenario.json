{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 nvs_rw_blob not-found & serialization boundary proof",
    "templateId": "esp_idfv61_nvs_nvs_rw_blob_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Saving test data blob...",
      "description": "[结构体持久化] 确认复杂聚合结构体写入 NVS"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Reading test data blob:",
      "description": "[持久化读出] 确认 Blob 数据反序列化就绪"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "ID: 123",
      "description": "[字段自检] 验证标量成员 ID 数据一致性"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Active: true",
      "description": "[布尔字段自检] 验证布尔标记字段完整性"
    }
  ]
}
