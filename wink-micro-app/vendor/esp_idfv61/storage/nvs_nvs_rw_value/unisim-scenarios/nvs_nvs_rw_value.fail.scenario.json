      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "INJECT_PLATFORM_FAULT",
      "timeUs": "0ms",
      "domain": "nvs",
      "fault": {
        "action": "read_corrupt",
        "param": 0
      },
      "description": "在启动阶段向 NVS 介质注入读取损坏故障 (ESP_FAULT_NVS_READ_CORRUPT)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "1500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Error (ESP_ERR_NVS_CORRUPT_KEY_PART) reading!",
      "description": "断言原厂固件捕获 NVS 读损坏故障并向串口输出 ESP_ERR_NVS_CORRUPT_KEY_PART 错误"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Returned to app_main",
      "description": "断言应用在异常处理后安全返回 app_main"
    }
  ]
