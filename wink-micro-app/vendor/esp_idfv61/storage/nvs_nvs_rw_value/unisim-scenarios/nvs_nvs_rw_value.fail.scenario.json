{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 nvs_rw_value flash corruption & type mismatch boundary proof",
    "templateId": "esp_idfv61_nvs_nvs_rw_value_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "1500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Opening Non-Volatile Storage (NVS) handle...",
      "description": "[NVS句柄开启] 验证存储句柄初始化成功"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "1500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read counter = 42",
      "description": "[数值字段读取] 验证整型计数器读取正确"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "1500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read string: Hello from NVS!",
      "description": "[字符串完整性] 验证字符串字段无截断或乱码"
    }
  ]
}
