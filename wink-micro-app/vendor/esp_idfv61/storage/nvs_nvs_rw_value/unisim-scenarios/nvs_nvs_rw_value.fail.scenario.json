{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 nvs_rw_value flash corruption & read boundary proof",
    "templateId": "esp_idfv61_nvs_nvs_rw_value_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
