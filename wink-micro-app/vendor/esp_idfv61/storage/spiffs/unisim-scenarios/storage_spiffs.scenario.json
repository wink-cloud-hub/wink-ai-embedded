{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 storage_spiffs headless deterministic proof",
    "templateId": "esp_idfv61_storage_spiffs",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing SPIFFS",
      "description": "断言系统开始初始化 SPIFFS 分区"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Partition size: total: 896321, used: 0",
      "description": "断言成功获取并打印 SPIFFS 分区总容量与初始占用空间"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Opening file",
      "description": "断言开始创建并打开测试文件 hello.txt"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "File written",
      "description": "断言成功向 SPIFFS 写入 Hello World 数据"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Renaming file",
      "description": "断言执行文件重命名 hello.txt -> foo.txt"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read from file: 'Hello World!'",
      "description": "断言从重命名后的 foo.txt 文件正确回读出内容 'Hello World!'"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "SPIFFS unmounted",
      "description": "断言优雅注销并安全卸载 SPIFFS 分区"
    }
  ]
}
