{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 storage_spiffs partition corrupted & file not found anomaly proof",
    "templateId": "esp_idfv61_storage_spiffs_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Initializing SPIFFS",
      "description": "[SPIFFS挂载就绪] 验证 VFS 文件系统分区挂载"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Opening file",
      "description": "[文件句柄操作] 确认创建打开文件流"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "File written",
      "description": "[文件系统写入] 验证数据写入扇区完整"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Read from file: 'Hello World!'",
      "description": "[回读验证] 验证文件系统读出数据与预期一致"
    }
  ]
}
