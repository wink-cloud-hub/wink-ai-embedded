{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 freertos_real_time_stats counter overflow & clock source anomaly proof",
    "templateId": "esp_idfv61_system_freertos_real_time_stats_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["50ms", "500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Getting real time stats over 100 ticks",
      "description": "[采样启动] 确认统计任务启动双点采样周期"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "| Task | Run Time | Percentage",
      "description": "[时钟源有效性] 确认任务执行时间片非零并正确输出统计表头"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "spin0",
      "description": "[任务记账防御] 确认忙循环任务 CPU 记账数据完整"
    }
  ]
}
