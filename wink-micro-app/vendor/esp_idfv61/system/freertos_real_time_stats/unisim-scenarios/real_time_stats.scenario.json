{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 freertos_real_time_stats headless deterministic proof",
    "templateId": "esp_idfv61_system_freertos_real_time_stats",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["50ms", "500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Getting real time stats over 100 ticks",
      "description": "断言 stats_task 成功启动并开始第一轮两点采样度量"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "| Task | Run Time | Percentage",
      "description": "断言采样窗口期结束后输出结构化任务执行度量表头"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "spin0",
      "description": "断言任务快照成功捕获 spin0 任务运行状态"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "stats",
      "description": "断言任务快照成功捕获 stats 守护任务自身运行状态"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1000ms", "2500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Real time stats obtained",
      "description": "断言 print_real_time_stats 返回 ESP_OK 并完成当轮统计输出闭环"
    }
  ]
}
