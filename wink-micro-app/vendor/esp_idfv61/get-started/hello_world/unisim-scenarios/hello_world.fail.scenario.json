{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 hello_world startup timing & flash boundary proof",
    "templateId": "esp_idfv61_hello_world_fail",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Hello world!",
      "description": "[启动完整性] 断言 UART0 TX 正常输出 Hello world! 引导问候"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "4MB external flash",
      "description": "[Flash边界防御] 断言 SPI Flash 容量自省参数正确"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["0ms", "500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Restarting in 10 seconds...",
      "description": "[倒计时稳态] 断言初始倒计时就绪为 10 秒"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["950ms", "1500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Restarting in 9 seconds...",
      "description": "[时钟抖动防御] 严禁提早翻转，断言仅在 1000ms 窗口后进入 9 秒"
    }
  ]
}
