{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 BSD Sockets TCP Client Deterministic Proof",
    "templateId": "esp_idfv61_protocols_sockets_tcp_client",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "1000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Socket created, connecting to 192.168.0.165:3333",
      "description": "断言创建 BSD Socket 并向目标服务器发起 TCP 连接"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "1000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Successfully connected",
      "description": "断言 TCP 三次握手成功完成，Socket 状态进入已连接"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "1500ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Received 19 bytes from 192.168.0.165:",
      "description": "断言成功从远程 TCP 服务器接收回显数据并获取报文长度"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "1500ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Message from ESP32 ",
      "description": "断言接收到的 TCP 载荷数据内容与预期严格一致"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "2000ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "Shutting down socket and restarting...",
      "description": "断言远端断开连接后客户端优雅关闭 Socket 并触发重连机制"
    }
  ]
}
