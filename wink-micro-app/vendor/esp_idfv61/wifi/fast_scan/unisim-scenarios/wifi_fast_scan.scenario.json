{
  "header": {
    "version": "1.0.0",
    "name": "ESP-IDF v6.1 Wi-Fi Fast Scan & Connection Deterministic Proof",
    "templateId": "esp_idfv61_wifi_fast_scan",
    "accuracyMode": "behavioral",
    "timeoutUs": "3000ms",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
      "type": "INJECT_WIFI_FIXTURE",
      "timeUs": "0ms",
      "accessPoints": [
        {
          "ssid": "myssid",
          "bssid": "00:11:22:33:44:55",
          "rssi": -45,
          "channel": 1,
          "authMode": "WPA2_PSK",
          "password": "mypassword",
          "dhcp": {
            "assignedIp": "192.168.1.100",
            "netmask": "255.255.255.0",
            "gateway": "192.168.1.1",
            "dns": "192.168.1.1"
          }
        },
        {
          "ssid": "Nearby_AP",
          "bssid": "00:11:22:33:44:56",
          "rssi": -75,
          "channel": 6,
          "authMode": "OPEN",
          "password": ""
        }
      ]
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "50ms",
      "target": "power:VCC_3V3",
      "condition": "equals",
      "expected": 3.3,
      "matcher": 3.3,
      "description": "断言系统供电轨稳定维持 3.3V"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "netif:sta:ip",
      "condition": "equals",
      "expected": "192.168.1.100",
      "matcher": "192.168.1.100",
      "description": "断言 STA 接口通过快速扫描及 DHCP 协商成功取得 IP 192.168.1.100"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "wifi:sta:state",
      "condition": "equals",
      "expected": "GOT_IP",
      "matcher": "GOT_IP",
      "description": "断言 Wi-Fi 底座状态机推进至 GOT_IP 状态"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": [
        "0ms",
        "1500ms"
      ],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "got ip:192.168.1.100",
      "description": "断言 UART 控制台输出扫描连接后获取的 IP 日志"
    },
    {
      "type": "INJECT_WIFI_FIXTURE",
      "timeUs": "2000ms",
      "fault": {
        "targetSsid": "myssid",
        "action": "DROP_BEACON",
        "reason": "BEACON_TIMEOUT"
      }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "2500ms",
      "target": "wifi:sta:state",
      "condition": "equals",
      "expected": "DISCONNECTED",
      "matcher": "DISCONNECTED",
      "description": "断言信标丢失故障注入后 Wi-Fi 状态准确流转至 DISCONNECTED"
    }
  ]
}
