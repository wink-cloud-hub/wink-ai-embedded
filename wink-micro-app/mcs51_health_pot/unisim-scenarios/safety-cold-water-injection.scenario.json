{
  "header": {
    "version": "1.0.0",
    "name": "mcs51_health_pot safety: cold-water injection mid-heat never fakes a dry-fire (single-edge guard + re-warm ramp)",
    "templateId": "mcs51_health_pot",
    "description": "PLAN-20260915 Task 3 scene 4. A +50-code cold-water step at 5 s re-closes the slope gate; the scripted re-warm ramp then drops the code domain by >=6 codes per 16 s window so the slope verdict stays legitimately satisfied and E-03 never fires. Authoring rule: holding the code flat below 45 C would be a legal dry-fire and a trip would be correct firmware behavior.",
    "accuracyMode": "behavioral",
    "timeoutUs": "60000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "30ms",
      "adcChannel": 0,
      "valueNorm": 0.0586,
      "description": "Static 25 C water before the first control tick (code ~240)"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "400ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "700ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "Heating normally"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "5000ms",
      "adcChannel": 0,
      "valueNorm": 0.0708,
      "description": "Cold-water shot: +50 code step (240 -> 290); the single-edge guard resets the ring and re-closes slope_valid_sec"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "15000ms",
      "adcChannel": 0,
      "valueNorm": 0.0688,
      "description": "Re-warm ramp: 282 (~21.5 C), >=6 codes below the 5 s sample"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "25000ms",
      "adcChannel": 0,
      "valueNorm": 0.0669,
      "description": "Re-warm ramp: 274 (~22.5 C)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "35000ms",
      "adcChannel": 0,
      "valueNorm": 0.0649,
      "description": "Re-warm ramp: 266 (~23.5 C)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "45000ms",
      "adcChannel": 0,
      "valueNorm": 0.0630,
      "description": "Re-warm ramp: 258 (~24.2 C)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "55000ms",
      "adcChannel": 0,
      "valueNorm": 0.0610,
      "description": "Re-warm ramp: 250 (~25 C); every 16 s window drops >=8 codes"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["20500ms", "23500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "After the 16 clean-sample relearn window (~21-22 s) the slope gate is satisfied by the ramp: no false E-03"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "40000ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "Still heating 35 s after the injection"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["44000ms", "47000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "Mid-ramp frame stays fault-free"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "58000ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "No dry-fire at the 60 s timeout edge: 53 s of post-injection heating without E-03"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["57500ms", "59500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "Final frame: HEAT with heater on, F=0"
    }
  ]
}
