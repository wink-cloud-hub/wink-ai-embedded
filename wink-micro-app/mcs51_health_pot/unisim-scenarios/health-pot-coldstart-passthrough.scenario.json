{
  "header": {
    "version": "1.0.0",
    "name": "mcs51_health_pot L1: winter cold-start fast downward ramp passes the single-edge guard (no E-01)",
    "templateId": "mcs51_health_pot",
    "accuracyMode": "behavioral",
    "timeoutUs": "8500000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "30ms",
      "adcChannel": 0,
      "valueNorm": 0.1118,
      "description": "Winter tap water ~10 C (raw ~458) before first control tick"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "400ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "700ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "Heating starts normally at 10 C"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "2500ms",
      "adcChannel": 0,
      "valueNorm": 0.0962,
      "description": "Downward ramp -64 codes/s (458 -> 394): ~4 C/s, downward edge naturally penetrates"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "3500ms",
      "adcChannel": 0,
      "valueNorm": 0.0806,
      "description": "-64 codes/s (394 -> 330)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "4500ms",
      "adcChannel": 0,
      "valueNorm": 0.0649,
      "description": "-64 codes/s (330 -> 266)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "5500ms",
      "adcChannel": 0,
      "valueNorm": 0.0493,
      "description": "-64 codes/s (266 -> 202)"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "6500ms",
      "adcChannel": 0,
      "valueNorm": 0.0337,
      "description": "-64 codes/s (202 -> 138, ~39 C)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["2900ms", "3200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "No E-01 during the fast downward ramp"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["5900ms", "6200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "Still healthy after five 64-code steps (single-edge guard ignores falling edges)"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["6900ms", "7200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": { "$regex": "T=0(3[6-9]|4[0-2])C,S=1,H=1,F=0" },
      "minPackets": 1,
      "description": "Firmware-measured temperature follows the downward code ramp into the high-30s (LUT ~39 C)"
    }
  ]
}
