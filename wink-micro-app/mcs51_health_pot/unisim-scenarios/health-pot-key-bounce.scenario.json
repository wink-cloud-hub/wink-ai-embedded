{
  "header": {
    "version": "3.0",
    "name": "mcs51_health_pot key bounce: 8 ms contact chatter is debounced to exactly one press event",
    "templateId": "mcs51_health_pot",
    "accuracyMode": "timing",
    "timeoutUs": "6000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "30ms",
      "adcChannel": 0,
      "valueNorm": 0.0586,
      "description": "Cold water before first control tick: raw ~240 -> 25 C"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "400ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true, "bounceUs": 8000, "bounceCount": 8, "pressDurationUs": 300000 },
      "description": "Atomic press pair (ADR-0068) with 8 ms deterministic contact chatter inside the leading edge"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "1000ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false },
      "description": "Explicit release (already past the scheduled pair release at ~708 ms)"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1500ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "Bounce produced exactly one press: heating started"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["1900ms", "2200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=1,F=0",
      "minPackets": 1,
      "description": "Still heating 1.5 s after the chatter: no phantom second press/re-entry"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "3500ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true, "bounceUs": 8000, "bounceCount": 8, "pressDurationUs": 300000 },
      "description": "Second bounced press: must toggle OFF exactly once"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "4100ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "4600ms",
      "target": "plugin:heater_relay/on",
      "matcher": false,
      "description": "Single toggle to standby, contact forced open"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["4900ms", "5200ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=0,H=0,F=0",
      "minPackets": 1,
      "description": "No double-toggle re-entry: standby holds"
    }
  ]
}
