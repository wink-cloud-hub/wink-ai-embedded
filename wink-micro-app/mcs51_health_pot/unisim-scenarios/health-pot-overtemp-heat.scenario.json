{
  "header": {
    "version": "3.0",
    "name": "mcs51_health_pot safety: beyond-scale code during HEAT never fakes boil completion, E-04 latches after 10 s",
    "templateId": "mcs51_health_pot",
    "accuracyMode": "behavioral",
    "timeoutUs": "18000000",
    "failurePolicy": "fail-fast",
    "determinism": { "prngSeed": 42 }
  },
  "steps": [
    {
      "type": "INPUT_ANALOG",
      "timeUs": "30ms",
      "adcChannel": 0,
      "valueNorm": 0.0586,
      "description": "Cold water before first control tick: raw ~240 -> 25 C"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "400ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "700ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "1200ms",
      "target": "plugin:heater_relay/on",
      "matcher": true,
      "description": "Heating starts normally"
    },
    {
      "type": "INPUT_ANALOG",
      "timeUs": "2000ms",
      "adcChannel": 0,
      "valueNorm": 0.0037,
      "description": "Plate runs beyond scale without ever passing through the 98 C boil band: raw ~15 (<= OVERTEMP_RAW 16, distinct from short <=8); valueNorm = 15/4096"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "4000ms",
      "target": "plugin:heater_relay/on",
      "matcher": false,
      "description": "Beyond-scale band forces the contact open during the 10 s qualification window"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "4000ms",
      "target": "plugin:display/text",
      "matcher": "99b0",
      "description": "Still HEAT (105 C clamped to 99) - the beyond-scale reading must not complete the boil hold nor enter WARM"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "8000ms",
      "target": "plugin:led_warm/on",
      "matcher": false,
      "description": "No false boil-complete: WARM is never entered from an unmeasurable plate temperature"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["4500ms", "5500ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=1,H=0,F=0",
      "minPackets": 1,
      "description": "Qualification window: HEAT state, heater off, no fault latched yet"
    },
    {
      "type": "ASSERT_POINT",
      "timeUs": "12500ms",
      "target": "plugin:display/text",
      "matcher": "E-04",
      "description": "10 continuous seconds beyond scale latch over-temp E-04"
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["12500ms", "14000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=3,H=0,F=4",
      "minPackets": 1,
      "description": "Telemetry: FAULT over-temp, manual reset required"
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "15000ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": true }
    },
    {
      "type": "INPUT_PLUGIN_EVENT",
      "timeUs": "15300ms",
      "targetPluginId": "btn_onoff",
      "action": "SET_PRESSED",
      "params": { "pressed": false }
    },
    {
      "type": "ASSERT_BUS_PAYLOAD",
      "windowUs": ["15500ms", "17000ms"],
      "busType": "uart",
      "busId": 0,
      "direction": "tx",
      "matcher": "S=0,H=0,F=0",
      "minPackets": 1,
      "description": "Manual ON/OFF clears the E-04 latch back to standby"
    }
  ]
}
