{
  "header": {
    "version": "1.0.0",
    "name": "mcs51_health_pot L1: cold-water upset re-closes the slope gate for 16 clean samples (no instant E-03)",
    "templateId": "mcs51_health_pot",
    "accuracyMode": "behavioral",
    "timeoutUs": "26000000",
    "failurePolicy": "fail-fast",
    "determinism": {
      "prngSeed": 42
    }
  },
  "steps": [
    {
