# Gate rule set
# ─────────────────────────────────────────────────────────────────
# 1. readability-braces-around-statements: enforce braces around statements
# 2. misc-no-recursion: statically detect recursive call chains for stack safety
# 3. clang-analyzer-security.insecureAPI.alloca: forbid alloca / VLA for stack safety
# 4. bugprone-no-escape: detect block pointer escape
Checks: >
    -*,
    readability-braces-around-statements,
    misc-no-recursion,
    clang-analyzer-security.insecureAPI.alloca,
    bugprone-no-escape
WarningsAsErrors: '*'
