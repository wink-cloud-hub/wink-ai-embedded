/**
 * @file wink_selftest_registry.def
 * @brief X-macro registry: registers one selftest entry per line.
 *
 * Columns:
 *   1. entry name (C identifier; prefix selftest_)
 *   2. string name (dotted naming: subsystem.test)
 *   3. function (wink_selftest_fn type)
 *
 * Usage:
 *   In selftest_core.c:
 *     #define WINK_SELFTEST_ENTRY(entry, name_str, fn) { name_str, fn },
 *     static const wink_selftest_entry_t s_registry[] = {
 *     #include "wink_selftest_registry.def"
 *     };
 *
 * Adding a selftest: append a line to this file.
 */

/* PWM router frequency isolation test (S5) */
WINK_SELFTEST_ENTRY(pwm_router_freq_isolation,  "pwm_router.freq_isolation",  wink_selftest_pwm_router_freq_isolation)

/* I2C bus scan (S6) */
WINK_SELFTEST_ENTRY(i2c_bus_scan,               "i2c.bus_scan",               wink_selftest_i2c_bus_scan)

/* Dual-core critical section resource stress test (S7) */
WINK_SELFTEST_ENTRY(smp_resource_stress,        "smp.resource_stress",        wink_selftest_smp_resource_stress)

/* GPIO ISR arg round-trip (S4-isr) */
WINK_SELFTEST_ENTRY(gpio_isr_roundtrip,         "gpio.isr_roundtrip",         wink_selftest_gpio_isr_roundtrip)

/* RMT hardware loopback capture (S9) */
WINK_SELFTEST_ENTRY(rmt_self_loopback,          "rmt.self_loopback",          wink_selftest_rmt_self_loopback)
