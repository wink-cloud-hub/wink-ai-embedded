{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules"
    ],
    "noEmit": true,
    "paths": {
      "vue": [
        "./node_modules/vue"
      ],
      "@wokwi/elements": [
        "./node_modules/@wokwi/elements"
      ],
      "@wink-ai/unisim-ui": [
        "./node_modules/@wink-ai/unisim-ui"
      ],
      "@wink-ai/unisim-ui/vite": [
        "./node_modules/@wink-ai/unisim-ui/dist/vite.d.ts",
        "./node_modules/@wink-ai/unisim-ui/src/vite/index.ts"
      ],
      "@wink-ai/unisim-ui/generator": [
        "./node_modules/@wink-ai/unisim-ui/dist/generator.d.ts",
        "./node_modules/@wink-ai/unisim-ui/src/generator/index.ts"
      ],
      "@wink-ai/unisim-ui/*": [
        "./node_modules/@wink-ai/unisim-ui/*"
      ],
      "@wink-ai/unisim-sdk": [
        "./node_modules/@wink-ai/unisim-sdk"
      ],
      "@wink-ai/unisim-sdk/*": [
        "./node_modules/@wink-ai/unisim-sdk/*"
      ]
    }
  },
  "include": [
    "builtin/**/src/**/*",
    "builtin/**/*.d.ts",
    "builtin/**/vite.config.*.ts"
  ]
}
