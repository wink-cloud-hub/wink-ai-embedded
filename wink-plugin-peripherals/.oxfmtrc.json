{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/*.min.js",
    "**/bun.lock",
    "**/artifacts/**",
    "**/test-results/**"
  ]
}
