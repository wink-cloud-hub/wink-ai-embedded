{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "led DeviceTree Config",
  "type": "object",
  "properties": {
    "type": {
      "const": "led"
    },
    "variant": {
      "type": "string",
      "default": "default"
    },
    "color": {
      "type": "string",
      "default": "red",
      "enum": [
        "red",
        "green",
        "blue",
        "yellow",
        "white",
        "orange",
        "purple"
      ]
    },
    "brightness": {
      "type": "number",
      "default": 1,
      "minimum": 0,
      "maximum": 1
    },
    "label": {
      "type": "string",
      "default": ""
    },
    "activeHigh": {
      "type": "boolean",
      "default": true
    },
    "contactWelded": {
      "type": "boolean",
      "default": false
    },
    "faultType": {
      "type": "string",
      "default": "NONE",
      "enum": [
        "NONE",
        "CONTACT_WELDED"
      ]
    },
    "pullDownResistor": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "x-wink-pins": [
    {
      "name": "A",
      "direction": "sink",
      "signal": "digital",
      "required": false,
      "simRole": "anode",
      "catalogType": "gpio",
      "aliases": [
        "anode",
        "gpio"
      ]
    },
    {
      "name": "C",
      "direction": "ground",
      "signal": "power",
      "required": false,
      "simRole": "cathode",
      "catalogType": "power",
      "aliases": [
        "cathode"
      ]
    }
  ]
}
