{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ultrasonic DeviceTree Config",
  "type": "object",
  "properties": {
    "type": {
      "const": "ultrasonic"
    },
    "variant": {
      "type": "string",
      "default": "default"
    },
    "backend": {
      "type": "string",
      "default": "auto"
    },
    "maxDistanceCm": {
      "type": "number",
      "default": 400,
      "minimum": 2,
      "maximum": 400
    },
    "minDistanceCm": {
      "type": "number",
      "default": 2,
      "minimum": 0,
      "maximum": 10
    },
    "speedOfSoundMps": {
      "type": "number",
      "default": 343,
      "minimum": 300,
      "maximum": 400
    },
    "useRmt": {
      "type": "boolean",
      "default": false
    },
    "autoPollMs": {
      "type": "number",
      "default": 50,
      "minimum": 0,
      "maximum": 10000
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "x-wink-pins": [
    {
      "name": "TRIG",
      "direction": "sink",
      "signal": "digital",
      "required": true,
      "catalogType": "gpio"
    },
    {
      "name": "ECHO",
      "direction": "source",
      "signal": "digital",
      "required": true,
      "catalogType": "gpio"
    },
    {
      "name": "VCC",
      "direction": "power",
      "signal": "power",
      "required": false,
      "simRole": "vcc",
      "catalogType": "power"
    },
    {
      "name": "GND",
      "direction": "ground",
      "signal": "power",
      "required": false,
      "simRole": "gnd",
      "catalogType": "power"
    }
  ]
}
