{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rc_servo DeviceTree Config",
  "type": "object",
  "properties": {
    "type": {
      "const": "rc_servo"
    },
    "variant": {
      "type": "string",
      "default": "sg90"
    },
    "minAngle": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 180
    },
    "maxAngle": {
      "type": "number",
      "default": 180,
      "minimum": 0,
      "maximum": 180
    },
    "minPulseMs": {
      "type": "number",
      "default": 0.5,
      "minimum": 0.3,
      "maximum": 1
    },
    "maxPulseMs": {
      "type": "number",
      "default": 2.5,
      "minimum": 2,
      "maximum": 3
    },
    "framePeriodMs": {
      "type": "number",
      "default": 20,
      "minimum": 1,
      "maximum": 100
    },
    "pwmChannel": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 15
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "x-wink-pins": [
    {
      "name": "PWM",
      "direction": "source",
      "signal": "analog",
      "required": true,
      "simRole": "pwm",
      "catalogType": "pwm"
    },
    {
      "name": "VCC",
      "direction": "power",
      "signal": "power",
      "required": false,
      "voltage": "5V",
      "simRole": "vcc",
      "catalogType": "power"
    },
    {
      "name": "GND",
      "direction": "ground",
      "signal": "power",
      "required": false,
      "simRole": "gnd",
      "catalogType": "power"
    }
  ]
}
