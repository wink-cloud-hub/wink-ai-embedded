{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "buzzer DeviceTree Config",
  "type": "object",
  "properties": {
    "type": {
      "const": "buzzer"
    },
    "variant": {
      "type": "string",
      "default": "passive_pwm",
      "enum": [
        "passive_pwm",
        "active_gpio"
      ]
    },
    "defaultFreqHz": {
      "type": "number",
      "default": 2000,
      "minimum": 20,
      "maximum": 8000
    },
    "pwmChannel": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 15
    },
    "activeHigh": {
      "type": "boolean",
      "default": true
    },
    "label": {
      "type": "string",
      "default": "Buzzer"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false,
  "x-wink-pins": [
    {
      "name": "1",
      "direction": "source",
      "signal": "analog",
      "required": true,
      "simRole": "pwm",
      "catalogType": "pwm",
      "aliases": [
        "1",
        "sig",
        "signal",
        "pwm",
        "anode",
        "pos"
      ]
    },
    {
      "name": "2",
      "direction": "ground",
      "signal": "power",
      "required": false,
      "simRole": "gnd",
      "catalogType": "power",
      "aliases": [
        "2",
        "gnd",
        "ground",
        "cathode",
        "neg"
      ]
    }
  ]
}
